<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Consultas UVV</title>
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <a class="visually-hidden-focusable" href="#conteudo">Pular para o conteúdo</a>
    <header class="bg-success">
        <nav class="container py-3 d-flex flex-wrap gap-3 justify-content-between align-items-center" aria-label="Navegação principal">
            <a class="text-white text-decoration-none fw-semibold fs-5 d-inline-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.svg" alt="" width="36" height="36" />
                Consultas UVV
            </a>
            <div class="d-flex gap-3 align-items-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="text-white" asp-controller="Consultas" asp-action="Index">Minhas consultas</a>
                <form asp-controller="Conta" asp-action="Sair" method="post"><button class="btn btn-outline-light btn-sm" type="submit">Sair</button></form>
            }
            else
            {
                <a class="text-white" asp-controller="Conta" asp-action="Login">Entrar</a>
                <a class="btn btn-light btn-sm" asp-controller="Conta" asp-action="Cadastro">Cadastrar usuário</a>
            }
            </div>
        </nav>
    </header>
    <main id="conteudo" class="container py-4">
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success" role="status">@mensagem</div>
        }
        @RenderBody()
    </main>
    <footer class="container border-top py-3 text-secondary small">Desenvolvimento Web Back-end · UVV · 2026</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
