@model List<Consulta>
@{ ViewData["Title"] = "Minhas consultas"; }
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Minhas consultas</h1><p class="text-secondary mb-0">Usuário: @User.Identity?.Name</p></div>
    <a class="btn btn-success" asp-action="Criar">Cadastrar consulta</a>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-light border">Nenhuma consulta cadastrada.</div>
}
else
{
    <div class="table-responsive bg-white border rounded">
        <table class="table table-striped align-middle mb-0">
            <caption class="px-3">@Model.Count consulta(s), em ordem de data.</caption>
            <thead><tr><th scope="col">Especialidade</th><th scope="col">Data e horário</th><th scope="col">Descrição</th><th scope="col">Ações</th></tr></thead>
            <tbody>
            @foreach (var consulta in Model)
            {
                <tr>
                    <td class="description">@consulta.Especialidade</td>
                    <td class="text-nowrap">@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="description">@consulta.Descricao</td>
                    <td><div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-success" asp-action="Editar" asp-route-id="@consulta.Id" aria-label="Editar consulta de @consulta.Especialidade">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@consulta.Id" aria-label="Excluir consulta de @consulta.Especialidade">Excluir</a>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
