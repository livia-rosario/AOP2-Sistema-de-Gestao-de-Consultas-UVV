@{ ViewData["Title"] = "Início"; }
<section class="home-card card mx-auto text-center" aria-labelledby="inicio-titulo">
    <img class="mx-auto mb-4" src="~/images/logo.svg" alt="" width="72" height="72" />
    <h1 id="inicio-titulo" class="h3 fw-semibold mb-3">Sistema de Gestão de Consultas UVV</h1>
    <p class="text-secondary mb-4">Cadastre, visualize, edite e exclua suas consultas.</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-success" asp-controller="Consultas" asp-action="Index">Minhas consultas</a>
    }
    else
    {
        <a class="btn btn-success" asp-controller="Conta" asp-action="Login">Entrar</a>
        <a class="btn btn-outline-success" asp-controller="Conta" asp-action="Cadastro">Cadastrar usuário</a>
    }
    </div>
</section>
