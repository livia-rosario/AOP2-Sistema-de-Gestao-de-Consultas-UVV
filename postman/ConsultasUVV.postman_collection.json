{
  "info": {
    "name": "Consultas UVV - Cadastro, login e CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Aplicação ASP.NET Core MVC: retorna HTML e redirecionamentos, não JSON. Execute em ordem ou use Run collection. Mantenha cookies ativados e redirects desativados. O primeiro passo gera um e-mail fictício diferente por execução. A consulta de teste é excluída ao final; a conta de teste fica cadastrada. Para recomeçar após uma interrupção, apague os cookies de localhost. Não é necessário Bearer Token."
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5195",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "senha",
      "value": "TestePostman!2026",
      "type": "string"
    },
    {
      "key": "antiforgery",
      "value": "",
      "type": "string"
    },
    {
      "key": "consultaId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Abrir cadastro e obter token",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/Conta/Cadastro"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email\", \"postman.\" + Date.now() + \"@example.invalid\");",
              "pm.collectionVariables.unset(\"consultaId\");",
              "pm.collectionVariables.unset(\"antiforgery\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const match = pm.response.text().match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);",
              "pm.test(\"Token antiforgery presente\", function () { pm.expect(match).not.to.equal(null); });",
              "if (match) pm.collectionVariables.set(\"antiforgery\", match[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cadastrar usuário (POST)",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/Conta/Cadastro",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "__RequestVerificationToken",
              "value": "{{antiforgery}}",
              "type": "text"
            },
            {
              "key": "Nome",
              "value": "Usuário Postman",
              "type": "text"
            },
            {
              "key": "Email",
              "value": "{{email}}",
              "type": "text"
            },
            {
              "key": "Senha",
              "value": "{{senha}}",
              "type": "text"
            },
            {
              "key": "ConfirmarSenha",
              "value": "{{senha}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status HTTP 302\", function () { pm.response.to.have.status(302); });"
            ]
          }
        }
      ]
    },
