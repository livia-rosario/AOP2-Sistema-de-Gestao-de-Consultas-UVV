          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const match = pm.response.text().match(/name=\"__RequestVerificationToken\"[^>]*value=\"([^\"]+)\"/);",
              "pm.test(\"Token antiforgery presente\", function () { pm.expect(match).not.to.equal(null); });",
              "if (match) pm.collectionVariables.set(\"antiforgery\", match[1]);",
              "const matchId = pm.response.text().match(/href=\"\\/Consultas\\/Editar\\/(\\d+)\"/);",
              "pm.test(\"Consulta salva e identificada\", function () { pm.expect(matchId).not.to.equal(null); pm.expect(pm.response.text()).to.include(\"Cardiologia\"); });",
              "if (matchId) pm.collectionVariables.set(\"consultaId\", matchId[1]);"
            ]
          }
        }
      ]
